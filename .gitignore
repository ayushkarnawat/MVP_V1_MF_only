# Python
__pycache__/
*.pyc
.venv/
*.db
.pytest_cache/
backend/.cache/
backend/pytest_tmp/
pytest_tmp/

# Node
node_modules/
dist/

# Env
.env

# OS
.DS_Store

# Git worktrees (superpowers subagent-driven-development)
.worktrees/

# Coding-agent tooling installs (e.g. the impeccable design skill) — kept on
# disk so any coding agent working in this checkout can use them, but not
# tracked: they're environment tooling, not application code, and get
# updated independently of this repo (npx impeccable skills install/update).
.agents/skills/
.claude/skills/

# understand-anything plugin scratch state — knowledge-graph.json, meta.json,
# fingerprints.json, and intermediate/scan-result.json ARE tracked
# intentionally (a fresh session reuses them instead of re-scanning), but
# per-run trash/tmp scratch dirs are disposable and must never be committed
# (a prior session accidentally did this — see .ua/.trash-1786098818 cleanup).
.ua/.trash-*/
.ua/tmp/
