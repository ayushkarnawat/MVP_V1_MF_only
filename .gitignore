# Superpowers brainstorming companion (local scratch, not for commit)
.superpowers/

# Python
__pycache__/
*.pyc
.venv/
*.db
.pytest_cache/
.pytest_tmp/
backend/.pytest_tmp/
backend/.cache/
backend/pytest_tmp/
pytest_tmp/

# Node
node_modules/
dist/

# Env
.env

# OS
.DS_Store

# Git worktrees (superpowers subagent-driven-development)
.worktrees/

# Coding-agent tooling installs (e.g. the impeccable design skill) — kept on
# disk so any coding agent working in this checkout can use them, but not
# tracked: they're environment tooling, not application code, and get
# updated independently of this repo (npx impeccable skills install/update).
.agents/skills/

# .claude/skills/ is NOT ignored — project-authored skills (task-observer,
# model-orchestration, etc.) are tracked and committed like any other repo
# content, per explicit decision 2026-08-12. Only externally-managed tooling
# installs (above) stay untracked.

# understand-anything plugin scratch state — knowledge-graph.json, meta.json,
# fingerprints.json, and intermediate/scan-result.json ARE tracked
# intentionally (a fresh session reuses them instead of re-scanning), but
# per-run trash/tmp scratch dirs are disposable and must never be committed
# (a prior session accidentally did this — see .ua/.trash-1786098818 cleanup).
.ua/.trash-*/
.ua/tmp/

# Per-developer Claude Code settings (hooks, env overrides, local plugin
# state) and headroom's own runtime state file — both machine-specific and
# never safe to share via git (a prior session committed these by mistake,
# baking one developer's hardcoded local binary path and localhost proxy
# port into every clone). .claude/settings.json (shared project config,
# e.g. enabledPlugins) stays tracked.
.claude/settings.local.json
.claude/.headroom_wrap_marker.json
