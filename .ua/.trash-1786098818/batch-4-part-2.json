  {
   "id": "file:backend/app/services/dashboard/aggregate.py",
   "type": "file",
   "name": "aggregate.py",
   "filePath": "backend/app/services/dashboard/aggregate.py",
   "summary": "Family-level aggregation service: derives each member's data status from confirmed imports and fans every dashboard view (holdings, allocation, SIPs, cash flow, snapshots) out across all of a user's household members.",
   "tags": [
    "service",
    "dashboard",
    "aggregation"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:backend/app/services/dashboard/allocation.py",
   "type": "file",
   "name": "allocation.py",
   "filePath": "backend/app/services/dashboard/allocation.py",
   "summary": "Computes portfolio allocation by bucketing current holdings into asset classes (derived from SEBI category) and AMCs, returning percentage breakdowns of total value.",
   "tags": [
    "service",
    "dashboard",
    "allocation"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:backend/app/services/dashboard/arn_lookup.py",
   "type": "file",
   "name": "arn_lookup.py",
   "filePath": "backend/app/services/dashboard/arn_lookup.py",
   "summary": "Resolves distributor ARN codes against the AMFI directory with an arn_directory cache, classifying each as active, suspended, or invalid by valid-till date, and returning None without caching on fetch failure.",
   "tags": [
    "service",
    "external-api",
    "caching",
    "distributor"
   ],
   "complexity": "moderate"
  },
  {
   "id": "file:backend/app/services/dashboard/cash_flow.py",
   "type": "file",
   "name": "cash_flow.py",
   "filePath": "backend/app/services/dashboard/cash_flow.py",
   "summary": "Builds a chronological cash-flow ledger from transactions: purchases are debits, redemptions and dividend payouts are credits, and switch-in/out legs are excluded as internal transfers.",
   "tags": [
    "service",
    "dashboard",
    "cash-flow"
   ],
   "complexity": "simple"
  },
  {
   "id": "file:backend/app/services/dashboard/distributor_comparison.py",
   "type": "file",
   "name": "distributor_comparison.py",
   "filePath": "backend/app/services/dashboard/distributor_comparison.py",
   "summary": "Compares one member's holdings of a single scheme across distributors (PRD-03 FR-11): groups folios by ARN code, runs the shared FIFO lot engine per group, values units at current NAV, and resolves distributor names via arn_lookup.",
   "tags": [
    "service",
    "dashboard",
    "distributor",
    "fifo"
   ],
   "complexity": "moderate",
   "languageNotes": "Reuses holdings.py's _LOT_CONSUMING_TYPES constant for the same-date purchase-before-redemption tiebreak so the two engines stay in lockstep by construction."
  },
  {
   "id": "file:backend/app/services/dashboard/holdings.py",
   "type": "file",
   "name": "holdings.py",
   "filePath": "backend/app/services/dashboard/holdings.py",
   "summary": "The FIFO holdings engine: replays each folio's transactions as purchase lots with a same-date purchase-before-redemption tiebreak, merges folios per scheme, and values remaining units at the latest NAV to produce holding rows with absolute and day-change gains.",
   "tags": [
    "service",
    "dashboard",
    "fifo",
    "holdings"
   ],
   "complexity": "moderate",
   "languageNotes": "Orders same-date transactions with a SQL case() putting lot-consuming types last, because Transaction.id is a random uuid4 and an id-only tiebreak would nondeterministically under-consume lots."
  },
  {
   "id": "file:backend/app/services/dashboard/household_members.py",
