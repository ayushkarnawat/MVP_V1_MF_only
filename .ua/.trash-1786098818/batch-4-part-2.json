   "name": "household_members.py",
   "filePath": "backend/app/services/dashboard/household_members.py",
   "summary": "Household-member CRUD scoped to the owning user: create, list ordered by creation time, and a user-scoped fetch that dashboard routes use as their authorization check.",
   "tags": [
    "service",
    "crud",
    "authorization"
   ],
   "complexity": "simple"
  },
  {
