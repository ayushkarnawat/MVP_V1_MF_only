  {
   "id": "file:backend/app/services/import_/service.py",
   "type": "file",
   "name": "service.py",
   "filePath": "backend/app/services/import_/service.py",
   "summary": "Core CAS import service implementing the parse/confirm flow: builds a TTL'd in-memory preview session from a parsed CAS (enriching each scheme via mfapi.in), then on confirmation persists the Import, upserts Schemes and Folios, and inserts transactions deduped on (folio, date, amount, units, type).",
   "tags": [
    "service",
    "cas-import",
    "persistence",
    "session"
   ],
   "complexity": "complex",
   "languageNotes": "Preview sessions live in an in-process dict with TTL sweeping — acceptable for the single-process MVP but not multi-worker safe. Low-confidence scheme matches are rejected atomically (nothing written) unless explicitly overridden."
  },
