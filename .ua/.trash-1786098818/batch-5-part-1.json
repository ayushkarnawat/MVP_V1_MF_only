  {
   "id": "file:backend/app/services/dashboard/snapshots.py",
   "type": "file",
   "name": "snapshots.py",
   "filePath": "backend/app/services/dashboard/snapshots.py",
   "summary": "Monthly portfolio snapshot service: backfills month-end portfolio values per member from the first transaction month onward, replaying FIFO lots and pricing them with cached NAV, and persists each computed month into portfolio_snapshots.",
   "tags": [
    "service",
    "snapshot",
    "dashboard",
    "backfill"
   ],
   "complexity": "moderate",
   "languageNotes": "Applies the same purchase-before-redemption same-date tiebreak as the holdings engine (Transaction.id is a random uuid4), and deliberately skips caching a month when NAV is unavailable so a transient NAV outage stays retryable instead of freezing a wrong value."
  },
  {
   "id": "function:backend/app/services/dashboard/snapshots.py:_iter_month_ends",
   "type": "function",
   "name": "_iter_month_ends",
   "filePath": "backend/app/services/dashboard/snapshots.py",
   "lineRange": [
    31,
    41
   ],
   "summary": "Yields every month-end date between a start and end date, inclusive.",
   "tags": [
    "utility",
    "date",
    "generator"
   ],
   "complexity": "simple"
  },
  {
   "id": "function:backend/app/services/dashboard/snapshots.py:get_snapshots",
   "type": "function",
   "name": "get_snapshots",
   "filePath": "backend/app/services/dashboard/snapshots.py",
   "lineRange": [
    44,
    131
   ],
   "summary": "Returns monthly SnapshotRow values per member: serves cached portfolio_snapshots rows where present, and for missing months replays each folio's transactions through the FIFO lot engine as of month end, prices holdings via get_nav_on_or_before, caches the result, and skips caching when NAV is unavailable.",
   "tags": [
    "snapshot",
    "backfill",
    "fifo",
    "caching"
   ],
   "complexity": "complex"
  },
