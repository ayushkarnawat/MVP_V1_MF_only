DATABASE_URL=sqlite:///./unifolio_dev.db
TEST_DATABASE_URL=postgresql+psycopg2://unifolio:unifolio@localhost:5433/unifolio_test
ENVIRONMENT=development
ALLOWED_ORIGINS=
OTP_DELIVERY_MODE=stub
EMAIL_DELIVERY_MODE=stub
SES_FROM_EMAIL=
PAN_ENCRYPTION_KEY=
PAN_LOOKUP_PEPPER=
CAS_FILE_STORAGE_DIR=var/cas_files
# PAN_LOOKUP_PEPPER also keys (via a derived key) the IP hash in consent_records.
# NEWS_ENABLED=true            # kill switch for the Home news feed (job and routes); off by default
# NEWS_DISABLED_SOURCES=       # comma-separated domains to drop at ingest and request time
# HEALTHCHECK_NEWS_URL=        # Healthchecks.io heartbeat pinged by refresh_news.py on a successful run
# NSE_SYMBOL_FILL_ENABLED=true   # enables scripts/jobs/fill_nse_symbols.py (fills NULL stock_master.nse_symbol); off by default
# NSE_SYMBOL_FILL_URL=            # override the NSE EQUITY_L.csv URL
