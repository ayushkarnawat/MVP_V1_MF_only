# LeapSwitch/CloudPe staging environment (Docs/orchestration/leapswitch-staging-plan.html).
# Copy to .env on the VM (chmod 600, root-only) and fill in real values.
# Never commit the real .env.

# --- Database (postgres service in docker-compose.yml) ---
DB_USERNAME=unifolio
DB_PASSWORD=
DB_NAME=unifolio

# --- Public domains (Caddyfile) ---
LS_FRONTEND_DOMAIN=ls-staging.unifolio.in
LS_API_DOMAIN=ls-staging-api.unifolio.in
# Redesign preview link (branch leapswitch-redesign); frontend only, same API.
LS_REDESIGN_DOMAIN=ls-redesign.unifolio.in
# Absolute paths of the two built bundles on the VM. Keep them absolute: the
# main clone serves ls-staging, the redesign worktree serves ls-redesign.
MAIN_FRONTEND_DIST=/opt/unifolio/frontend/dist
REDESIGN_FRONTEND_DIST=/opt/unifolio-redesign/frontend/dist

# --- App config (backend + worker; see backend/app/config.py) ---
ENVIRONMENT=staging
FRONTEND_BASE_URL=https://ls-staging.unifolio.in
ALLOWED_ORIGINS=https://ls-staging.unifolio.in,https://ls-redesign.unifolio.in
GOOGLE_OAUTH_CLIENT_ID=

# --- PAN encryption (D3: new keys, not reused from AWS staging -- see the
# plan's D3 section for when/why this changes) ---
PAN_ENCRYPTION_KEY=
PAN_LOOKUP_PEPPER=

# --- Email (D4: stays on real AWS SES regardless of host). A new SES-only
# IAM user's static keys -- boto3's default credential chain picks these up
# automatically, no code change needed. Kept separate from the
# OBJECT_STORAGE_* keys below so the two never collide on this VM. ---
EMAIL_DELIVERY_MODE=ses
SES_FROM_EMAIL=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Failure-alert recipient for deploy/leapswitch/scripts/run-job.sh (reuses
# the SES provider above via backend/scripts/send_job_failure_alert.py) --
# use the same address(es) already subscribed to AWS staging's ops-alerts
# SNS topic (infra/envs/staging/terraform.tfvars's alert_emails).
OPS_ALERT_EMAIL=

# --- CAS file storage: CloudPe's S3-compatible object storage (D4 gates
# real CAS uploads on CloudPe confirming encryption at rest -- see that
# section before setting this to "s3" with real data). ---
CAS_FILE_STORAGE_BACKEND=local
CAS_FILES_BUCKET_NAME=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Separate bucket for scripts/backup.sh's daily pg_dump uploads (distinct
# from CAS_FILES_BUCKET_NAME so CAS-file retention/expiry logic never touches
# backups).
BACKUP_BUCKET_NAME=

# --- D2: recompute dispatch. docker-compose.yml already sets these two on
# the backend service; repeated here for reference, not required in .env. ---
# ANALYTICS_DISPATCH_MODE=worker_container
# WORKER_CONTAINER_URL=http://worker:8008

# --- Home news feed (T6) ---
# NEWS_ENABLED=true            # kill switch for the Home news feed (job and routes); off by default
# NEWS_DISABLED_SOURCES=       # comma-separated domains to drop at ingest and request time
# HEALTHCHECK_NEWS_URL=        # Healthchecks.io heartbeat pinged by refresh_news.py on a successful run
