# LeapSwitch staging job schedule -- replaces AWS's 11 EventBridge Scheduler
# entries (infra/modules/scheduler/main.tf) with plain VM cron, since CloudPe
# has no managed scheduler. Every time below is copied directly from that
# Terraform file's schedule_expression values, which are already IST
# (schedule_expression_timezone = "Asia/Kolkata"), hence CRON_TZ below.
#
# Install on the VM with: crontab deploy/leapswitch/crontab.leapswitch
# (edit the absolute path below first to match where this repo lives on the VM)
#
# One exception from a straight copy: stock-fundamentals-daily is moved from
# 05:45 to 05:55 IST to avoid colliding with portfolio-disclosures-daily at
# the same minute -- the fix this plan's "Which VM size" / memory-budget
# section already calls for, applied here rather than left as a to-do.

CRON_TZ=Asia/Kolkata
RUN=/opt/unifolio/deploy/leapswitch/scripts/run-job.sh
CHECK_MEM=/opt/unifolio/deploy/leapswitch/scripts/check-memory.sh

0  6  *  *  *              $RUN nav-daily                    scripts/jobs/refresh_nav_daily.py
15 6  *  *  *              $RUN scheme-master-daily           scripts/jobs/refresh_scheme_master_daily.py
0  6  *  *  *              $RUN benchmark-daily               scripts/jobs/refresh_benchmark_daily.py
20 6  *  *  *              $RUN ter-daily                     scripts/jobs/refresh_ter_daily.py
0  6  10 *  *              $RUN fund-managers-monthly         scripts/jobs/refresh_fund_managers_monthly.py
45 5  1-20 * *             $RUN portfolio-disclosures-daily   scripts/jobs/refresh_portfolio_disclosures_daily.py
55 5  *  *  *              $RUN stock-fundamentals-daily      scripts/jobs/refresh_stock_fundamentals_daily.py
45 5  1-15 1,7 *           $RUN market-cap-half-yearly        scripts/jobs/refresh_market_cap_half_yearly.py
0  6  1  1,4,7,10 *        $RUN aaum-quarterly                scripts/jobs/refresh_aaum_quarterly.py
30 6  *  *  *              $RUN analytics-recompute-all       scripts/run_analytics_recompute.py --all
0  8  *  *  *              $RUN delete-expired-accounts-daily scripts/jobs/delete_expired_accounts_daily.py
0  19 *  *  *              $RUN cas-file-expiry-daily         -m app.scripts.expire_cas_files

# Memory watch over the tightest window in the 16 GB budget: both daily
# batch jobs above (05:45/05:55) plus analytics-recompute-all's 5-slot
# worker pool (06:30) overlapping daytime use -- added 16 Oct 2026 alongside
# the worker mem_limit/MAX_CONCURRENT_RECOMPUTES bump (docker-compose.yml,
# worker_server.py). Alerts via the same SES path as $RUN jobs; see
# check-memory.sh.
40,45,50,55 5  *  *  *     $CHECK_MEM
0,5,10,15,20,25,30,35 6 *  *  *  $CHECK_MEM
